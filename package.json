{
  "name": "whatsapp-sales-ai",
  "version": "1.0.0",
  "private": true,
  "description": "扫码登录 WhatsApp Web 的本地 AI 自动聊单与报价审核工作台",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning server.js",
    "db:check": "node --disable-warning=ExperimentalWarning scripts/check-database.js",
    "db:backup": "node --disable-warning=ExperimentalWarning scripts/backup-database.js",
    "mysql:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mysql-dev.ps1",
    "local-ai:qwen35": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-qwen35.ps1",
    "local:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-stack.ps1",
    "local:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-stack.ps1 -Monitor",
    "local:install-autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-autostart.ps1",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "test:local-ai": "node scripts/local-ai-smoke.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.11.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "fs-extra": "^11.3.4",
    "mysql2": "^3.24.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.4",
    "unzipper": "^0.12.5",
    "whatsapp-web.js": "^1.34.7"
  }
}
