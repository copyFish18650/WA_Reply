PORT=3010
HOST=127.0.0.1
DATA_DIR=./data
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=whatsapp_sales
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=whatsapp_sales_ai
MYSQL_CONNECTION_LIMIT=8
# 云数据库要求 TLS 时设置为 true
MYSQL_SSL=false
# 可选，mysqldump 不在 PATH 时填写完整路径
MYSQLDUMP_PATH=
# 生产环境必须设置：32 字节密钥（64 位十六进制或 base64），用于加密扫码登录会话
AUTH_SESSION_ENCRYPTION_KEY=
# WhatsApp 登录会话写入数据库的周期，最少 60000 毫秒
WHATSAPP_SESSION_BACKUP_INTERVAL_MS=300000
LOCAL_AI_PROVIDER=llama.cpp
LOCAL_AI_BASE_URL=http://127.0.0.1:11435
LOCAL_AI_MODEL=local
# 风格学习任务的等待时间（毫秒），CPU 推理默认最多等待 10 分钟
LOCAL_AI_STYLE_TIMEOUT_MS=600000
# 单个请求开始推理后计时；排队期间不消耗此时限
LOCAL_AI_REPLY_TIMEOUT_MS=300000
LOCAL_AI_TRANSLATION_TIMEOUT_MS=180000
LOCAL_AI_MEMORY_TIMEOUT_MS=600000
SUPPLIER_IMAGE_SEARCH_URL=
SUPPLIER_IMAGE_SEARCH_API_KEY=
CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
